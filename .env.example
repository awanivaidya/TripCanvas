# Copy this file to `.env` and fill in the values.
# `.env` is gitignored, so your secrets never get committed.

# Postgres connection string (from https://neon.tech -> your project -> Connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js (step 2). Generate the secret with: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Groq LLM (step 4). Free key from https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Google Maps Platform (place panel on cards). Two keys from the same Google Cloud project:
# - GOOGLE_MAPS_API_KEY: SECRET, used only on the server. Restrict it to "Places API (New)".
# - NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY: PUBLIC (it's visible in the page). Restrict it to
#   "Maps Embed API" + your website (http://localhost:3000/*). Optional: without it, no map.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=""

# Live event search (concerts, festivals, matches) for the trip chat, via SerpApi's Google Events.
# Free plan: https://serpapi.com/users/sign_up (about 250 searches a month). SECRET: server only.
# Without it, the chat says it can't check live events instead of inventing them.
SERPAPI_KEY=""
# The smaller, faster model for the new-trip chat helpers and "Getting there" (its own rate limits).
GROQ_FAST_MODEL="openai/gpt-oss-20b"

# Google Calendar ("Find free dates"): no new key. It uses the same AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET.
# In Google Cloud: enable "Google Calendar API", and add the scope .../auth/calendar.freebusy to the
# OAuth consent screen (Data access).
